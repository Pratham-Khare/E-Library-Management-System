# ---------------------------------------------------------------------------
# Secrets — NEVER commit these. .env holds the real DB credentials, JWT
# secrets, the AI API token and the SendGrid key. Only .env.example is tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Dependencies
node_modules/
.npm/
.pnp/
.pnp.js

# Runtime artefacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# Uploaded files (cover images, ebooks) — user data, not source code.
# The directories themselves are recreated at boot by the storage provider.
storage/
uploads/

# Build / cache
dist/
build/
coverage/
.cache/
.tmp/
tmp/

# Editors & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
