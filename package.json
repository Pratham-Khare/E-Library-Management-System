{
  "name": "e-library-management-system",
  "version": "1.0.0",
  "description": "Backend for an E-Library Management System — catalog, circulation, digital lending and AI-powered book summaries. Node.js + Express + MongoDB.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:verbose": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:api": "newman run docs/postman/E-Library.postman_collection.json -e docs/postman/E-Library.postman_environment.json",
    "seed": "node src/seeds/index.js",
    "seed:fresh": "node src/seeds/index.js --fresh",
    "seed:clear": "node src/seeds/index.js --clear",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\" \"docs/**/*.md\" \"*.md\""
  },
  "keywords": [
    "library",
    "e-library",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "openai",
    "rest-api"
  ],
  "author": "Pratham Khare",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "slugify": "^1.6.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "unpdf": "^1.8.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "newman": "^6.2.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2"
  }
}
