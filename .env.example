###############################################################################
#  E-LIBRARY MANAGEMENT SYSTEM — ENVIRONMENT TEMPLATE
#
#  Copy this file to `.env` and fill in the values:
#      Windows (PowerShell):  Copy-Item .env.example .env
#      macOS / Linux:         cp .env.example .env
#
#  Every variable here is read ONCE, in src/config/env.js, validated against a
#  Zod schema, and exposed through the frozen `config` object. No other file in
#  the codebase touches process.env. If a required value is missing or malformed
#  the server refuses to start and tells you exactly which key is wrong.
#
#  Values marked [REQUIRED] have no default — the app will not boot without them.
#  Everything else falls back to the default shown in brackets.
###############################################################################


# =============================================================================
#  1. APPLICATION
# =============================================================================

# Runtime mode. Controls error verbosity (stack traces are dev-only), log
# format, and whether destructive seed commands need confirmation.
# One of: development | production | test
NODE_ENV=development

# Port the HTTP server binds to.                                    [5000]
PORT=5000

# Host interface to bind. Use 0.0.0.0 in Docker/containers.         [0.0.0.0]
HOST=0.0.0.0

# Prefix every versioned route sits behind, e.g. /api/v1/books.     [/api/v1]
API_PREFIX=/api/v1

# Human-readable app name. Used in emails, Swagger, and log headers.
APP_NAME=E-Library Management System

# Public base URL of this API. Used to build absolute links in emails
# (password reset, due-date reminders) and file URLs.  [http://localhost:5000]
APP_URL=http://localhost:5000

# Number of reverse proxies in front of the app. Express uses this for
# `trust proxy`, which is what makes rate-limiting see the REAL client IP
# instead of the proxy's. 0 = direct connection (local dev).        [0]
TRUST_PROXY=0

# Request body size cap. Guards against memory-exhaustion payloads. [1mb]
BODY_LIMIT=1mb

# Seconds to wait for in-flight requests to finish on SIGTERM/SIGINT
# before forcing the process down.                                  [10]
SHUTDOWN_TIMEOUT_SECONDS=10


# =============================================================================
#  2. DATABASE (MongoDB)
# =============================================================================

# [REQUIRED] Connection string.
#   Local (no auth, matches the default Windows/macOS install):
#     mongodb://127.0.0.1:27017
#   Local WITH auth:
#     mongodb://<user>:<password>@127.0.0.1:27017/?authSource=admin
#   MongoDB Atlas:
#     mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
#
# NOTE: put the database NAME in MONGO_DB_NAME below, not in this URI, so the
# same URI can be reused across environments.
MONGO_URI=mongodb://127.0.0.1:27017

# [REQUIRED] Database name. Created automatically on first write.
MONGO_DB_NAME=elibrary

# Connection-pool sizing. Raise max under heavy concurrent load.    [10 / 2]
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# How long the driver hunts for a reachable server before giving up. [10000]
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Socket inactivity timeout.                                        [45000]
MONGO_SOCKET_TIMEOUT_MS=45000

# Log every Mongoose query to the console. Noisy — dev debugging only. [false]
MONGO_DEBUG=false


# =============================================================================
#  3. AUTHENTICATION (JWT)
#
#  Three SEPARATE secrets are used so that a leaked token of one kind cannot be
#  replayed as another. Generate strong random values — never ship the samples:
#      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#  Minimum accepted length is 32 characters; the app refuses to start otherwise.
# =============================================================================

# [REQUIRED] Signs short-lived access tokens sent on every request.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars

# How long an access token stays valid. Short by design — a stolen token
# expires quickly, and the refresh token covers the gap.            [15m]
JWT_ACCESS_EXPIRES_IN=15m

# [REQUIRED] Signs refresh tokens. MUST differ from the access secret.
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-min-32

# Refresh-token lifetime — effectively "stay logged in for".        [7d]
JWT_REFRESH_EXPIRES_IN=7d

# [REQUIRED] Signs password-reset tokens and signed file-download links.
JWT_RESET_SECRET=replace-me-with-a-third-long-random-string-min-32-ch

# Password-reset link validity. Deliberately short.                 [30m]
JWT_RESET_EXPIRES_IN=30m

# Signed file-download link validity. Very short — the link is handed out
# on demand and used immediately.                                   [5m]
JWT_DOWNLOAD_EXPIRES_IN=5m

# Standard JWT claims. Tokens minted for a different issuer/audience are
# rejected, which stops tokens from another service being replayed here.
JWT_ISSUER=e-library-api
JWT_AUDIENCE=e-library-client

# bcrypt work factor. Higher = slower to hash = harder to brute-force.
# 10 is a sane dev default; 12 is a good production value. Range 4-15. [10]
BCRYPT_SALT_ROUNDS=10


# =============================================================================
#  4. FIRST ADMIN ACCOUNT (bootstrap)
#
#  On first boot, if the database contains ZERO admin users, one is created
#  from these values so you always have a way in. Idempotent — it never runs
#  again once an admin exists. CHANGE THE PASSWORD after your first login.
# =============================================================================

BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Library Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@elibrary.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345


# =============================================================================
#  5. RATE LIMITING
#
#  Five independent limiter groups. Windows are in milliseconds. Every group is
#  wired up in src/config/rateLimit.js; the auth and AI groups are the ones that
#  actually matter for security and cost.
# =============================================================================

# Master switch. Turn off only for load testing.                    [true]
RATE_LIMIT_ENABLED=true

# GLOBAL — a blanket ceiling on every request from one IP.  [300 per 15 min]
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# AUTH — login / register / forgot-password. Tight, because this is the
# endpoint an attacker hammers with stolen credential lists.  [10 per 15 min]
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# SEARCH — catalogue search is DB-heavy, so it gets its own budget. [60/min]
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60

# UPLOAD — keyed per USER, not per IP.                           [20 per hour]
UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
UPLOAD_RATE_LIMIT_MAX=20

# AI — keyed per USER. This is the single most important limit in the file:
# the shared AI token has a hard lifetime quota of 100 calls, so without this
# one user could exhaust the budget for everyone.              [5 per 24 hours]
AI_RATE_LIMIT_WINDOW_MS=86400000
AI_RATE_LIMIT_MAX=5


# =============================================================================
#  6. CORS
# =============================================================================

# Comma-separated list of allowed browser origins. Use * to allow any origin
# (development only — it is incompatible with credentialed requests).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow cookies / Authorization headers on cross-origin requests.   [true]
CORS_CREDENTIALS=true


# =============================================================================
#  7. AI SERVICE
#
#  Proxies to OpenAI gpt-4o-mini. The supplied token has a HARD LIFETIME QUOTA
#  OF 100 CALLS, which is why this whole subsystem is cache-first.
# =============================================================================

AI_API_BASE_URL=https://ai-api.userfacet.com

# [REQUIRED-ish] Your bearer token. If this is blank or left as the
# placeholder below, the app automatically serves deterministic MOCK responses
# instead of failing — see AI_MOCK_MODE. It will still boot and every AI
# endpoint still works; the output is just clearly flagged as mock.
AI_API_TOKEN=sk-your-token-here

# Locked upstream — any other value returns 404 model_not_found.
AI_MODEL=gpt-4o-mini

# Upstream clamps this to 5000 max.                                 [1000]
AI_MAX_TOKENS=1000

# 0 = deterministic, 2 = wild. Low values keep summaries factual.   [0.4]
AI_TEMPERATURE=0.4

# Abort a hanging request after this long.                          [30000]
AI_TIMEOUT_MS=30000

# Retries on 5xx / network errors only (never on 400/401/404).      [2]
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500

# --- Mock mode -------------------------------------------------------------
# auto   = use mocks when the token is missing/invalid, or the quota is spent
#          and nothing is cached. Real calls otherwise.  <-- recommended
# always = never touch the network. Offline dev and zero-cost demos.
# never  = fail loudly instead of mocking. Use in production so a
#          misconfiguration cannot silently serve fake data.
AI_MOCK_MODE=auto

# --- Quota protection ------------------------------------------------------
# Total lifetime calls this deployment may spend. Enforced locally and
# reconciled against the upstream GET /v1/usage endpoint by a cron job.  [100]
AI_TOTAL_QUOTA=100

# Stop making live calls once this fraction of the quota is spent, so a
# reserve is always left for admin/demo use. 0.9 = stop at 90 of 100.  [0.9]
AI_QUOTA_SAFETY_THRESHOLD=0.9

# Persist generated summaries so a repeat request costs ZERO calls.    [true]
AI_CACHE_ENABLED=true

# Bump this string to invalidate every cached summary at once — it is part of
# the cache key. Change it whenever you edit a prompt template.        [v1]
AI_PROMPT_VERSION=v1

# Max characters of extracted ebook text fed into a prompt. Caps token
# spend on long books.                                              [12000]
AI_MAX_INPUT_CHARS=12000

# --- Feature flags (turn individual AI features off to save quota) ---------
AI_FEATURE_SUMMARY=true
AI_FEATURE_KEY_TAKEAWAYS=true
AI_FEATURE_SIMPLIFIED=true
AI_FEATURE_QA=true
AI_FEATURE_RECOMMENDATIONS=true
AI_FEATURE_REVIEW_MODERATION=true
AI_FEATURE_METADATA_ENRICHMENT=true


# =============================================================================
#  8. LIBRARY POLICY (the business rulebook)
#
#  These drive src/config/library.js. Changing a number here changes how the
#  library behaves — no code edit required.
# =============================================================================

# --- Loan periods, in days, by membership type ---
LOAN_PERIOD_DAYS_PUBLIC=14
LOAN_PERIOD_DAYS_STUDENT=21
LOAN_PERIOD_DAYS_FACULTY=30

# --- How many books may be on loan at once ---
MAX_ACTIVE_LOANS_PUBLIC=3
MAX_ACTIVE_LOANS_STUDENT=5
MAX_ACTIVE_LOANS_FACULTY=8

# --- Renewals. Each renewal grants a FRESH full loan period, so a student
#     with 21-day loans and 2 renewals gets up to 63 fine-free days. Renewal
#     is refused once a loan is already overdue. ---
MAX_RENEWALS_PUBLIC=2
MAX_RENEWALS_STUDENT=2
MAX_RENEWALS_FACULTY=2

# --- Fines ---
# Days of leniency AFTER the due date before any fine starts accruing.  [2]
FINE_GRACE_DAYS=2
# Charged per day once the grace period is exhausted.                   [5]
FINE_PER_DAY=5
# Ceiling per loan, so a forgotten book cannot accrue forever.        [500]
FINE_MAX_PER_LOAN=500
# Owe more than this and borrowing is blocked until you settle up.    [200]
FINE_BLOCK_BORROWING_ABOVE=200
# ISO 4217 currency code used in responses and emails.                [INR]
FINE_CURRENCY=INR

# --- Digital lending ---
# How long a digital loan lasts before it auto-expires.                 [7]
DIGITAL_LOAN_DAYS=7
# Default simultaneous readers per ebook when a book is created.        [3]
DIGITAL_DEFAULT_CONCURRENT_LICENSES=3

# --- Misc circulation ---
# Send a "due soon" reminder this many days before the due date.        [3]
DUE_REMINDER_DAYS_BEFORE=3
# Block borrowing entirely while the member has any overdue item.    [true]
BLOCK_BORROWING_WHEN_OVERDUE=true


# =============================================================================
#  9. FILE UPLOADS
# =============================================================================

# Storage backend: local | s3   (only `local` is implemented; the provider
# interface exists so S3 is a config swap, not a rewrite.)          [local]
STORAGE_PROVIDER=local

# Root directory for uploaded files, relative to the project root.
STORAGE_ROOT=storage

# Size caps, in megabytes.
MAX_COVER_SIZE_MB=5
MAX_EBOOK_SIZE_MB=50
MAX_AVATAR_SIZE_MB=2

# Accepted MIME types. Uploads are checked against BOTH the declared type and
# the file's real magic-number signature, so renaming evil.exe to book.pdf
# does not get past it.
ALLOWED_COVER_TYPES=image/jpeg,image/png,image/webp
ALLOWED_EBOOK_TYPES=application/pdf,application/epub+zip
ALLOWED_AVATAR_TYPES=image/jpeg,image/png,image/webp

# Extract text from uploaded PDFs to feed the AI summariser. If extraction
# fails the book still works — summaries just fall back to metadata.  [true]
EXTRACT_EBOOK_TEXT=true


# =============================================================================
#  10. EMAIL (SendGrid)
#
#  Leave SENDGRID_API_KEY blank for now. When MAIL_PROVIDER=sendgrid but the
#  key is missing or still a placeholder, the app logs ONE warning at boot and
#  transparently falls back to the console provider, which renders each email
#  to the log. Nothing breaks. Adding the key later is a pure .env change.
# =============================================================================

# console  = write emails to the log (no account needed)
# sendgrid = send for real via the SendGrid API
MAIL_PROVIDER=sendgrid

# [Add later] From your SendGrid dashboard: Settings > API Keys.
# Needs only the "Mail Send" permission.
SENDGRID_API_KEY=

# Must be a VERIFIED sender identity in SendGrid, or delivery is rejected.
MAIL_FROM_EMAIL=no-reply@elibrary.local
MAIL_FROM_NAME=E-Library

# Where replies go. Leave blank to reuse MAIL_FROM_EMAIL.
MAIL_REPLY_TO=

# Sandbox mode validates and bills nothing but does NOT deliver. Perfect for
# testing the integration without spamming real inboxes.           [false]
SENDGRID_SANDBOX_MODE=false

# Optional SendGrid Dynamic Template IDs (format: d-xxxxxxxx...). Leave blank
# to use the built-in HTML templates in src/services/mail/templates/.
SENDGRID_TEMPLATE_WELCOME=
SENDGRID_TEMPLATE_PASSWORD_RESET=
SENDGRID_TEMPLATE_DUE_SOON=
SENDGRID_TEMPLATE_OVERDUE=
SENDGRID_TEMPLATE_FINE_ISSUED=

# Master switch for outbound email. false = in-app notifications only. [true]
MAIL_ENABLED=true


# =============================================================================
#  11. SCHEDULED JOBS (node-cron)
#
#  Standard 5-field cron expressions. Set CRON_ENABLED=false to disable all
#  background work — useful when running several instances and you want only
#  one of them doing scheduled writes.
# =============================================================================

CRON_ENABLED=true

# IANA timezone the schedules are interpreted in.
CRON_TIMEZONE=Asia/Kolkata

# Mark loans overdue and accrue fines — daily at 00:30.
CRON_OVERDUE_CHECK=30 0 * * *

# "Your book is due soon" reminders — daily at 09:00.
CRON_DUE_REMINDER=0 9 * * *

# Expire digital loans whose term has elapsed — hourly.
CRON_DIGITAL_EXPIRY=0 * * * *

# Reconcile local AI call count against upstream /v1/usage — every 6 hours.
CRON_AI_USAGE_SYNC=0 */6 * * *

# Purge expired tokens and old read notifications — daily at 03:00.
CRON_CLEANUP=0 3 * * *


# =============================================================================
#  12. LOGGING
# =============================================================================

# error | warn | info | http | debug
LOG_LEVEL=debug

# Directory for rotating log files, relative to the project root.
LOG_DIR=logs

# Also write logs to files (not just the console).                  [true]
LOG_TO_FILE=true

# Log every HTTP request via morgan.                                [true]
LOG_HTTP_REQUESTS=true


# =============================================================================
#  13. API DOCUMENTATION
# =============================================================================

# Serve Swagger UI. Consider false in production if the API is private. [true]
SWAGGER_ENABLED=true

# Path Swagger UI is mounted at.                                [/api-docs]
SWAGGER_ROUTE=/api-docs
